/// A lead notification Make.com never accepted.
///
/// The lead itself is already safe in its own table — what is lost when the
/// webhook receiver is down is the alert, and with it the response time that
/// wins the buyer. Rows here are replayed through the normal sender once the
/// receiver is back, so an outage self-heals instead of quietly costing leads.
model WebhookDeadLetter {
  id          String    @id @default(uuid())
  event       String
  payload     Json
  error       String
  attempts    Int       @default(0)
  created_at  DateTime  @default(now())
  /// Null until a replay was accepted by the receiver.
  replayed_at DateTime?

  @@index([replayed_at, created_at])
  @@map("webhook_dead_letters")
}

