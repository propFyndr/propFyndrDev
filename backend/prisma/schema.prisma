/// Outbound notifications, written but NOT sent.
///
/// No email or SMS provider is wired up yet, so every notification the product
/// wants to send is queued here instead and dispatched by hand from the admin
/// panel. That is a deliberate interim state, and this table is what makes it
/// survivable: nothing is lost, every pending message is visible in one place,
/// and the day a provider is configured the sender reads this table rather than
/// needing every call site rewritten.
///
/// `action_url` carries the one-time link (invite, password reset). It is the
/// secret — anyone holding it can set that account's password — so this table
/// is super-admin-only and links expire.
model NotificationOutbox {
  id           String    @id @default(uuid())
  channel      String
  to_email     String?
  to_phone     String?
  template     String
  subject      String?
  body         String
  action_url   String?
  status       String    @default("queued")
  error        String?
  related_type String?
  related_id   String?
  created_at   DateTime  @default(now())
  sent_at      DateTime?
  sent_by      String?

  @@index([status, created_at])
  @@index([related_type, related_id])
  @@map("notification_outbox")
}

