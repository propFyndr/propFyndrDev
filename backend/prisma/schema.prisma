  project           Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  unit_type         UnitType  @relation(fields: [unit_type_id], references: [id], onDelete: Cascade)

  @@unique([project_id, tower_name, floor_number, unit_number])
  @@index([project_id])
  @@index([unit_type_id])
  @@index([status])
  @@map("unit_inventory")
}

// Junction table: link projects to channel partners with featured flag
model ProjectChannelPartner {
  id                  String    @id @default(uuid())
  project_id          String
  channel_partner_id  String
  is_featured         Boolean   @default(true)
  created_at          DateTime  @default(now())

  project             Project         @relation(fields: [project_id], references: [id], onDelete: Cascade)
  channel_partner     ChannelPartner  @relation(fields: [channel_partner_id], references: [id], onDelete: Cascade)

  @@unique([project_id, channel_partner_id])
  @@index([project_id])
  @@index([is_featured])
  @@map("project_channel_partners")
}

// ──────────────────────────────────────────────────────────────
// PHASE 0: CONVERSATION MEMORY (Session-scoped intent + reactions)
// ──────────────────────────────────────────────────────────────

model SessionMemory {
  id                    String    @id @default(cuid())
  session_id            String    @unique
  user_id               String?

  // Extracted intent snapshot for hydration across turns
  extracted_intent      Json?     // {bhk?, budget?, sector?, ...}

  // Property reactions tracking
  property_reactions    Json      @default("[]") // [{projectId, sentiment, signals}]

  // Saved property IDs in this session
  saved_property_ids    String[]  @default([])

  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  session               ChatSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id])
  @@index([user_id])
  @@map("session_memory")
}

// ──────────────────────────────────────────────────────────────
// PHASE 1: RESPONSE GRADING (Outcome-based iteration)
// ──────────────────────────────────────────────────────────────

model ResponseGrade {
  id                    String    @id @default(cuid())
  session_id            String
  message_id            String?

  // Outcome evaluation
  outcome_achieved      Boolean?
  grade_score           Int?      // 0-100 score
  grading_reason        String?

  // What outcomes were achieved?
  outcomes              String[]  @default([]) // ["saved", "callback_clicked", "question_asked"]

  // Retry control
  should_retry          Boolean   @default(false)
  retry_count           Int       @default(0)
  max_retries           Int       @default(1)

  graded_at             DateTime?
  created_at            DateTime  @default(now())

  session               ChatSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id])
  @@index([outcome_achieved])
  @@index([grade_score])
  @@map("response_grades")
}

model LeadObjection {
  id                       String    @id @default(uuid())
  callback_request_id      String
  project_slug             String
  project_name             String?
  reason_category          String    // "possession", "price", "product_mix", "location", "legal", "financing"
  reason_text              String
  confidence_score         Float?
  extracted_from_message_id String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  callbackRequest CallbackRequest @relation(fields: [callback_request_id], references: [id], onDelete: Cascade)

  @@index([callback_request_id])
  @@index([project_slug])
  @@index([reason_category])
  @@map("lead_objections")
}

model ProjectSpecItem {
  id           String    @id @default(uuid())
  project_id   String
  unit_type_id String?

  category     String
  label        String
  value        String
  brand        String?
  tier         String?

  source       DataSource @default(brochure)
  verified_at  DateTime?
  verified_by  String?

  is_highlight Boolean   @default(false)
  sort_order   Int       @default(0)
  notes        String?

  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  project      Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  unit_type    UnitType? @relation(fields: [unit_type_id], references: [id], onDelete: Cascade)

  @@index([project_id, category])
  @@index([project_id, is_highlight])
  @@index([brand])
  @@map("project_spec_items")
}

model GhostPoolAnalysis {
  id           String   @id @default(uuid())
  project_id   String
  week_start   DateTime
  total_matched Int      @default(0)
  total_converted Int    @default(0)
  by_reason    Json     @default("{}")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@unique([project_id, week_start])
  @@index([project_id])
  @@index([week_start])
  @@map("ghost_pool_analysis")
}

// Phase 5: User feedback on property recommendations
model PropertyFeedback {
  id         String   @id @default(uuid())
  session_id String
  project_id String

  sentiment  String   // "good" | "bad"
  reasons    String[] // JSON array: ["too_expensive", "possession_far", "wrong_location"]
  rating     Int?     // Optional 1-5 star rating
  comment    String?  // Optional user comment

  created_at DateTime @default(now())

  session    ChatSession @relation("PropertyFeedback", fields: [session_id], references: [id], onDelete: Cascade)
  project    Project? @relation("PropertyFeedback", fields: [project_id], references: [id], onDelete: SetNull)

  @@index([session_id])
  @@index([project_id])
  @@index([sentiment])
  @@map("property_feedback")
}

model AuditLog {
  id          String   @id @default(uuid())
  entity_type String   // "project" | "unit_type" | "cost_sheet" | "builder_news" | "bulk_import"
  entity_id   String
  entity_name String?  // human-readable name for display
  action      String   // "CREATE" | "UPDATE" | "DELETE" | "BULK_UPDATE"
  actor       String   @default("Admin")  // "Admin" | "System" | "BulkCSV" — display string, kept for back-compat
  // Real identity, additive. Nullable because every row written before this
  // migration, and every row written by the ADMIN_PASSWORD bootstrap login
  // (which has no AdminUser row), has none — `actor` above is what those
  // still display as.
  actor_admin_id String?
  ip_address  String?
  summary     String   // e.g. "Updated BSP from ₹6,500 to ₹6,800"
  changes     Json?    // Array<{ field: string, old: any, new: any, label: string }>
  created_at  DateTime @default(now())

  @@index([entity_type, entity_id])
  @@index([created_at])
  @@index([actor_admin_id])
  @@map("audit_logs")
}

enum AdminRole {
  SUPER_ADMIN
  ANALYST
  SALES
  BUILDER
  PARTNER
}

// Real admin identity, additive alongside the pre-existing single shared
// `ADMIN_PASSWORD` login — that login still works (see adminIdentity.ts) so
// nothing already deployed breaks; it now maps to a synthetic bootstrap
// SUPER_ADMIN identity rather than no identity at all. Every admin created
// here going forward has a real, trackable one.
//
// Two ways onto this table, both super-admin-only actions:
//  - Invite by email: `invite_token` set, `password_hash` null until accepted.
//  - Promote an existing buyer by their Supabase user id: `linked_supabase_user_id`
//    set, no separate password — they log into the admin panel with the same
//    Supabase session their buyer account already has.
model AdminUser {
  id                      String    @id @default(uuid())
  email                   String    @unique
  password_hash           String?
  role                    AdminRole

  // Scope for BUILDER / PARTNER roles. Null for SUPER_ADMIN / ANALYST / SALES.
  builder_id              String?
  builder                 Builder?        @relation(fields: [builder_id], references: [id])
  partner_id              String?
  partner                 ChannelPartner? @relation(fields: [partner_id], references: [id])

  // Ties this admin identity to an existing Supabase-authenticated buyer
  // account, so they can log in without a separate admin password.
  linked_supabase_user_id String?   @unique

  invited_by_admin_id     String?
  invite_token            String?   @unique
  invite_expires_at       DateTime?

  is_active               Boolean   @default(true)
  last_login_at           DateTime?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  @@index([role])
  @@index([builder_id])
  @@index([partner_id])
  @@map("admin_users")
}


