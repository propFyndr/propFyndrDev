generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Builder {
  id                         String                  @id @default(uuid())
  name                       String                  @unique
  slug                       String                  @unique
  tagline                    String?
  founder                    String?
  company_overview           String?
  logo_url                   String?
  parent_group               String?
  founded_year               Int?
  headquarters               String?
  website                    String?
  email                      String?
  phone                      String?
  description                String?
  experience_years           String?
  projects_delivered_count   Int?
  total_projects_count       Int?
  delivered_units            Int?
  delivered_projects         String[]
  ongoing_projects           String[]
  delayed_projects_count     Int?
  average_delay_months       Float?
  delivery_score             Int?
  construction_quality_score Int?
  after_sales_score          Int?
  buyer_satisfaction_score   Int?
  rera_compliance_score      Int?
  litigation_count           Int?
  insolvency_history         Boolean                 @default(false)
  legal_flag                 String?
  cin                        String?
  rera_promoter_id           String?
  financial_hygiene_score    Int?
  outstanding_dues_cr        Float?
  legal_entities             Json?
  executives                 Json?
  funding_banks              String[]
  audit_flags_log            String?
  luxury_specialization      Boolean                 @default(false)
  township_specialization    Boolean                 @default(false)
  affordable_specialization  Boolean                 @default(false)
  average_project_size       Int?
  awards                     String[]
  awards_count               Int?
  certifications             String[]
  credai_member              Boolean                 @default(false)
  iso_certified              Boolean                 @default(false)
  verification_level         String?
  last_verified_at           DateTime?
  data_source                String?
  intelligence_completeness  Int?
  created_at                 DateTime                @default(now())
  portal_subdomain           String?                 @unique
  admin_accounts             AdminUser[]
  delivery_records           BuilderDeliveryRecord[]
  leads                      BuilderLead[]
  news                       BuilderNews[]
  theme                      BuilderTheme?
  channel_partners           ChannelPartner[]
  projects                   Project[]

  @@map("builders")
}

model Project {
  id                               String                   @id @default(uuid())
  slug                             String                   @unique
  name                             String
  tagline                          String?
  builder_id                       String
  rera_number                      String?
  rera_url                         String?
  city                             String                   @default("Noida")
  state                            String                   @default("Uttar Pradesh")
  country                          String                   @default("India")
  sector                           String
  address                          String?
  lat                              Float?
  lng                              Float?
  land_area_acres                  Float?
  total_units                      Int?
  total_towers                     Int?
  floors                           String?
  open_space_pct                   Int?
  green_rating                     String?
  has_duplex                       Boolean                  @default(false)
  has_penthouse                    Boolean                  @default(false)
  project_type                     String?                  @default("Residential")
  status                           ProjectStatus
  launch_date                      DateTime?
  possession_date                  DateTime?
  possession_label                 String?
  possession_confidence            String?
  possession_confidence_note       String?
  oc_obtained                      Boolean?
  oc_obtained_date                 DateTime?
  oc_valid_until                   String?
  oc_restrictions                  String?
  rera_valid_until                 DateTime?
  legal_flag_detail                String?
  litigation_count                 Int?
  location_advantages              Json?
  location_concerns                String[]
  location_verdict                 String?
  walkability_score                Int?
  flood_waterlogging_risk          String?
  commute_matrix                   Json?
  description                      String?
  long_description                 String?
  design_theme                     String?
  architect                        String?
  interior_designer                String?
  marketing_claims                 String[]
  ai_search_keywords               String[]
  hero_image_url                   String?
  price_min_cr                     Float?
  price_range_label                String?
  builder_theme                    Json?
  created_at                       DateTime                 @default(now())
  updated_at                       DateTime                 @updatedAt
  project_risk_flag                String?
  escrow_bank_name                 String?
  registry_status                  String?
  registry_embargo_reasons         String[]
  nclt_moratorium_active           Boolean?
  air_quality_index_avg            Int?
  airport_distance_km              Float?
  approvals_status                 String?
  expected_handover_quarter        String?
  fir_against_project              Boolean?
  flood_zone                       String?
  foreign_currency_payment_allowed Boolean?
  foundation_stone_date            DateTime?
  green_cover_percent              Int?
  gst_pass_through                 Boolean?
  has_cctv                         Boolean?
  has_security_24x7                Boolean?
  hospital_distance_km             Float?
  land_title_clear                 Boolean?
  litigation_types                 String[]
  nri_approval_months              Int?
  occupancy_certificate_status     String?
  occupancy_expected_date          DateTime?
  occupancy_restriction_months     Int?
  ongoing_litigation_count         Int?
  police_station_distance_km       Float?
  proximity_to_industrial          String?
  rental_income_allowed            Boolean?
  rental_yield_annual_percent      Float?
  street_lights                    Boolean?
  top_school_distance_km           Float?
  ceiling_height_ft                Float?
  dg_power_rate_per_unit           Float?
  lifts_per_tower                  Int?
  maintenance_per_sqft_monthly     Float?
  shared_walls_type                String?
  water_source                     String?
  all_in_cost_multiplier           Float?
  amitabh_kant_clearance           Boolean?
  bank_apf_codes                   Json?
  lift_act_compliant               Boolean?
  oc_details                       String?
  oc_status                        OcStatus?
  power_supply_type                PowerSupplyType?
  shahdara_drain_impact            Boolean?
  water_source_type                WaterSourceType?
  water_tds_range                  String?
  embedding                        Unsupported("vector")?
  archived_duplicate_of            String?
  verified_at                      DateTime?                @default(now())
  verification_source              String?
  data_freshness_category          String?
  amenities                        Amenity[]
  chat_sessions                    ChatSession[]            @relation("ProjectFocusedChats")
  connectivity                     Connectivity[]
  construction_milestones          ConstructionMilestone[]
  construction_updates             ConstructionUpdate[]
  cost_sheet                       CostSheet?
  decision_profile                 DecisionProfile?
  payment_plans                    PaymentPlan[]
  price_history                    PriceHistory[]
  channel_partners                 ProjectChannelPartner[]
  referenced_as_competitor         ProjectCompetitor[]      @relation("CompetitorProject")
  competitors                      ProjectCompetitor[]      @relation("SourceProject")
  images                           ProjectImage[]
  lifecycle_updates                ProjectLifecycleUpdate[]
  spec_items                       ProjectSpecItem[]
  builder                          Builder                  @relation(fields: [builder_id], references: [id])
  property_feedback                PropertyFeedback[]       @relation("PropertyFeedback")
  saved_by                         SavedProperty[]
  unit_inventory                   UnitInventory[]
  unit_types                       UnitType[]

  @@index([city, sector])
  @@index([status])
  @@index([possession_date])
  @@index([builder_id])
  @@index([air_quality_index_avg])
  @@map("projects")
}

model DecisionProfile {
  id                     String             @id @default(uuid())
  project_id             String             @unique
  status                 IntelligenceStatus @default(DRAFT)
  decision_thesis        String?
  why_buy                String[]           @default([])
  why_avoid              String[]           @default([])
  best_for               String?
  not_ideal_for          String?
  financial_intelligence Json?
  market_intelligence    Json?
  builder_intelligence   Json?
  property_intelligence  Json?
  comparative_analysis   Json?
  resources_documents    Json?
  confidence_sources     String[]           @default([])
  recommendation_notes   String?
  advisor_notes          String?
  last_verified_at       DateTime?
  verified_by            String?
  created_at             DateTime           @default(now())
  updated_at             DateTime           @updatedAt
  project                Project            @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@map("decision_profiles")
}

model ProjectCompetitor {
  id                           String    @id @default(uuid())
  project_id                   String
  competitor_project_id        String?
  competitor_name              String
  competitor_slug              String?
  reason                       String?
  competitor_price_psf         Float?
  competitor_price_min_cr      Float?
  competitor_price_max_cr      Float?
  competitor_amenity_count     Int?
  competitor_possession_status String?
  this_project_advantage       String?
  competitor_advantage         String?
  verdict                      String?
  price_delta_note             String?
  sort_order                   Int       @default(0)
  last_verified_at             DateTime?
  verified_by                  String?
  created_at                   DateTime  @default(now())
  updated_at                   DateTime  @updatedAt
  competitor_project           Project?  @relation("CompetitorProject", fields: [competitor_project_id], references: [id])
  project                      Project   @relation("SourceProject", fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@map("project_competitors")
}

model IntelligenceAudit {
  id          String   @id @default(uuid())
  project_id  String
  section     String
  action      String
  before_data Json?
  after_data  Json?
  created_by  String?
  created_at  DateTime @default(now())

  @@index([project_id])
  @@index([project_id, section])
  @@map("intelligence_audits")
}

model UnitType {
  id                            String            @id @default(uuid())
  project_id                    String
  name                          String
  bhk                           Int
  has_servant_room              Boolean           @default(false)
  super_area_sqft               Int?
  super_area_range_sqft         String?
  carpet_area_sqft              Int?
  carpet_to_super_ratio_pct     Float?
  balconies                     Int?
  balcony_area_sqft             Int?
  bathrooms                     Int?
  utility_room                  Boolean           @default(false)
  dress_area                    Boolean           @default(false)
  towers                        String[]
  unit_orientations             String[]
  orientation_price_premium_pct Float?
  price_min_cr                  Float?
  price_max_cr                  Float?
  price_label                   String?
  price_per_sqft                Float?
  subtitle                      String?
  description                   String?
  category_badge                String?
  inventory_as_of               DateTime?
  whats_included                Json?
  layout_shape                  String?
  tower_association             String[]          @default(["Tower A"])
  built_up_area_sqft            Int?
  common_area_shaft_sqft        Int?
  spec_items                    ProjectSpecItem[]
  unit_inventory                UnitInventory[]
  project                       Project           @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id, bhk])
  @@index([project_id, price_min_cr, price_max_cr])
  @@map("unit_types")
}

model PriceHistory {
  id             String   @id @default(uuid())
  project_id     String
  recorded_at    DateTime @default(now())
  quarter_label  String?
  bhk            Int?
  price_per_sqft Float?
  total_price_cr Float?
  event_note     String?
  source         String   @default("monthly_auto_snapshot")
  project        Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id, recorded_at])
  @@map("price_history")
}

model ConstructionMilestone {
  id                 String             @id @default(uuid())
  project_id         String
  stage_code         String?
  name               String
  status             ConstructionStatus @default(upcoming)
  completion_pct     Int?
  date_label         String?
  planned_start      DateTime?
  planned_end        DateTime?
  actual_start       DateTime?
  completed_at       DateTime?
  tower              String?
  is_payment_trigger Boolean            @default(false)
  critical_path      Boolean            @default(false)
  verified_by_source String?
  photo_urls         String[]           @default([])
  sort_order         Int                @default(0)
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt
  project            Project            @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id, sort_order])
  @@map("construction_milestones")
}

/// Public-facing construction update feed (§7.A). One row per site update.
model ConstructionUpdate {
  id             String   @id @default(uuid())
  project_id     String
  title          String
  description    String?
  update_date    DateTime
  quarter_label  String?
  completion_pct Int?
  photo_urls     String[] @default([])
  source         String?
  verified_by    String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  project        Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id, update_date])
  @@map("construction_updates")
}

/// Post-delivery lifecycle updates for ready/delivered projects (§7.B).
/// 10 update types: amenity_addition | maintenance_team_change | maintenance_fee_update
/// | possession_issue_resolved | regulatory_compliance | price_update
/// | possession_status_change | legal_status_change | infrastructure_nearby
/// | building_certification
model ProjectLifecycleUpdate {
  id                          String   @id @default(uuid())
  project_id                  String
  update_type                 String
  title                       String
  description                 String?
  update_date                 DateTime
  impact                      String?
  source                      String?
  verified_by                 String?
  affects_pricing             Boolean  @default(false)
  affects_recommendation      Boolean  @default(false)
  legal_flag_cleared          Boolean  @default(false)
  maintenance_fee_monthly_psf Float?
  maintenance_fee_previous    Float?
  note                        String?
  created_at                  DateTime @default(now())
  updated_at                  DateTime @updatedAt
  project                     Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id, update_date])
  @@map("project_lifecycle_updates")
}

/// Sector-level market intelligence (§6.5). Filled once per sector, reused by every
/// project in it. Not project-scoped — keyed on (city, sector).
model SectorIntelligence {
  id                       String    @id @default(uuid())
  city                     String
  sector                   String
  sector_overview          String?
  sector_stage             String?
  dominant_segment         String?
  avg_price_per_sqft       Float?
  price_5yr_cagr_pct       Float?
  rental_yield_pct         Float?
  avg_rent_3bhk_monthly    Float?
  sector_strengths         String[]
  sector_weaknesses        String[]
  who_should_buy           String?
  who_should_avoid         String?
  infrastructure_pipeline  Json?
  last_verified_at         DateTime?
  verified_by              String?
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt
  micro_market             String?
  lifestyle_tags           String[]  @default([])
  commute_anchors          Json?
  utilities_profile        Json?
  statutory_rates          Json?
  airport_distance_km      Float?
  aqi_annual_avg           Float?
  aqi_monsoon_low          Float?
  aqi_winter_peak          Float?
  drainage_network_quality String?
  expressway_proximity_km  Float?
  flood_waterlogging_risk  String?
  flood_zone_description   String?
  metro_distance_km        Float?
  monitoring_station_name  String?
  nearest_metro_station    String?

  @@unique([city, sector])
  @@index([city, micro_market])
  @@map("sector_intelligence")
}

model BuilderDeliveryRecord {
  id            String    @id @default(uuid())
  builder_id    String
  project_name  String
  promised_date DateTime
  actual_date   DateTime?
  created_at    DateTime  @default(now())
  builder       Builder   @relation(fields: [builder_id], references: [id], onDelete: Cascade)

  @@index([builder_id])
  @@map("builder_delivery_records")
}

model ProjectImage {
  id         String    @id @default(uuid())
  project_id String
  url        String
  type       ImageType
  source     String    @default("admin")
  caption    String?
  bhk        Int?
  size_sqft  Int?
  sort_order Int       @default(0)
  project    Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id, type])
  @@index([project_id, source])
  @@map("project_images")
}

model Amenity {
  id         String          @id @default(uuid())
  project_id String
  name       String
  category   AmenityCategory
  project    Project         @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@map("amenities")
}

model Connectivity {
  id                   String           @id @default(uuid())
  project_id           String
  type                 ConnectivityType
  name                 String
  distance_km          Float?
  travel_time_min      Int?
  peak_travel_time_min Int?
  travel_mode          String?
  is_operational       Boolean          @default(true)
  category_rank        Int?
  rating               Float?
  extra_detail         String?
  data_source          DataSource       @default(brochure)
  notes                String?
  project              Project          @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@map("connectivity")
}

model ChatSession {
  id                 String             @id @default(uuid())
  user_id            String?
  guest_token        String?
  title              String?
  message_count      Int                @default(0)
  created_at         DateTime           @default(now())
  last_active        DateTime           @default(now())
  chat_phase         String             @default("DISCOVERY")
  last_projects      Json?
  shown_chip_ids     Json?              @default("[]")
  summary            String?
  focus_project_id   String?
  focus_set_at       DateTime?
  summary_location   String?
  summary_financial  String?
  summary_timeline   String?
  property_reactions Json?              @default("[]")
  is_bot             Boolean            @default(false)
  callback_requests  CallbackRequest[]  @relation("CallbackRequestChat")
  analytics          ChatAnalytics[]
  messages           ChatMessage[]
  focus_project      Project?           @relation("ProjectFocusedChats", fields: [focus_project_id], references: [id])
  dossiers           Dossier[]
  property_events    PropertyEvent[]
  property_feedback  PropertyFeedback[] @relation("PropertyFeedback")
  query_metrics      QueryMetrics[]
  response_grades    ResponseGrade[]
  memory             SessionMemory?

  @@index([user_id])
  @@index([guest_token])
  @@map("chat_sessions")
}

model ChatMessage {
  id              String      @id @default(uuid())
  session_id      String
  role            MessageRole
  content         String
  intent_snapshot Json?
  created_at      DateTime    @default(now())
  artifacts       Json?
  chips           Json?       @default("[]")
  edited_at       DateTime?
  is_verified     Boolean?    @default(false)
  session         ChatSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id, created_at])
  @@map("chat_messages")
}

model UserMemory {
  id                     String   @id @default(uuid())
  user_id                String?  @unique
  bhk_preference         Int?
  budget_min_cr          Float?
  budget_max_cr          Float?
  sector_preference      String?
  purpose                String?
  possession_pref        String?
  viewed_slugs           String[]
  rejected_slugs         String[]
  saved_slugs            String[]
  summary_text           String?
  updated_at             DateTime @updatedAt
  work_location          String?
  home_loan_pre_approved Boolean?
  timeline_months        Int?
  contact_phone          String?
  guest_token            String?  @unique

  @@map("user_memory")
}

model SavedProperty {
  id         String   @id @default(uuid())
  user_id    String
  project_id String
  saved_at   DateTime @default(now())
  project    Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([user_id, project_id])
  @@index([user_id])
  @@map("saved_properties")
}

model SiteVisitRequest {
  id                  String          @id @default(uuid())
  project_id          String
  project_slug        String
  project_name        String
  name                String
  phone               String
  email               String?
  visit_date          DateTime
  time_slot           String
  message             String?
  created_at          DateTime        @default(now())
  status              SiteVisitStatus @default(pending)
  user_id             String?
  /// See CallbackRequest.chased_at.
  chased_at           DateTime?
  guest_token         String?
  assigned_partner_id String?
  assigned_at         DateTime?
  partner_notes       String?
  assigned_partner    ChannelPartner? @relation("SiteVisitPartner", fields: [assigned_partner_id], references: [id])

  @@index([project_slug])
  @@index([status, chased_at])
  @@index([user_id])
  @@index([guest_token])
  @@index([assigned_partner_id])
  @@map("site_visit_requests")
}

model CallbackRequest {
  id                  String          @id @default(uuid())
  name                String
  phone               String
  project_name        String?
  project_slug        String?
  user_id             String?
  guest_token         String?
  status              String          @default("new")
  lead_score          Float?
  lead_tier           String?
  intent_tier         String?
  loan_pre_approved   Boolean?
  ai_summary          String?
  consent_given       Boolean?
  projects_saved      Int?            @default(0)
  projects_viewed     Int?            @default(0)
  budget_min_cr       Float?
  budget_max_cr       Float?
  created_at          DateTime        @default(now())
  source_intent       Json?
  source_session      String?
  chat_session_id     String?
  assigned_at         DateTime?
  assigned_partner_id String?
  partner_notes       String?
  chased_at           DateTime?
  is_test             Boolean         @default(false)
  first_contacted_at  DateTime?
  assigned_partner    ChannelPartner? @relation(fields: [assigned_partner_id], references: [id])
  chat_session        ChatSession?    @relation("CallbackRequestChat", fields: [chat_session_id], references: [id])
  objections          LeadObjection[]

  @@index([project_slug])
  @@index([lead_tier])
  @@index([created_at])
  @@index([chat_session_id])
  @@index([assigned_partner_id])
  @@index([status, chased_at])
  @@index([is_test])
  @@index([first_contacted_at])
  @@map("callback_requests")
}

model PriceAlert {
  id              String   @id @default(uuid())
  user_id         String?
  guest_token     String?
  project_id      String
  project_slug    String
  target_price_cr Float
  notified        Boolean  @default(false)
  created_at      DateTime @default(now())

  @@index([project_slug])
  @@map("price_alerts")
}

model ProjectDocument {
  id              String   @id @default(uuid())
  project_id      String
  project_slug    String
  name            String
  storage_url     String
  content_text    String?
  doc_type        String   @default("brochure")
  file_size_bytes Int?
  created_at      DateTime @default(now())

  @@index([project_slug])
  @@map("project_documents")
}

model PaymentPlan {
  id                    String    @id @default(uuid())
  project_id            String
  plan_type             String    @default("construction_linked")
  plan_name             String?
  description           String?
  milestones            Json      @default("[]")
  down_payment_pct      Float?
  booking_amount_lakh   Float?
  total_duration_months Int?
  discount_offered_pct  Float?
  best_for              String?
  watch_out             String?
  sort_order            Int       @default(0)
  source                String?
  source_url            String?
  verified_at           DateTime?
  verified_by           String?
  notes                 String?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  project               Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([project_id, plan_type])
  @@index([project_id, sort_order])
  @@map("payment_plans")
}

model CostSheet {
  id                      String    @id @default(uuid())
  project_id              String    @unique
  base_price_per_sqft     Float?
  base_cost_cr            Float?
  floor_rise_per_floor    Float?
  plc_charges             Json      @default("[]")
  parking_cost            Float?
  ifms                    Float?
  club_membership         Float?
  other_charges           Json      @default("[]")
  gst_applicable          Boolean?
  gst_rate_pct            Float     @default(5.0)
  gst_note                String?
  stamp_duty_pct          Float     @default(6.0)
  registration_pct        Float     @default(1.0)
  electricity_connection  Float?
  water_sewer_connection  Float?
  maintenance_psf_monthly Float?
  all_inclusive_price_cr  Float?
  all_inclusive_per_sqft  Float?
  assumptions             String[]
  verified_at             DateTime?
  verified_by             String?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt
  project                 Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@map("cost_sheets")
}

model ChatAnalytics {
  id                           String      @id @default(uuid())
  session_id                   String
  user_id                      String?
  guest_token                  String?
  chat_started_at              DateTime    @default(now())
  intent_identified_at         DateTime?
  results_shown_at             DateTime?
  first_engagement_at          DateTime?
  conversion_at                DateTime?
