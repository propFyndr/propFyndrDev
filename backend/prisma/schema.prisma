generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Builder {
  id                 String    @id @default(uuid())

  // Identity
  name               String    @unique
  slug               String    @unique
  tagline            String?
  founder            String?
  company_overview   String?
  logo_url           String?
  parent_group       String?
  founded_year       Int?
  headquarters       String?
  website            String?
  email              String?
  phone              String?
  description        String?

  // Track Record
  experience_years          String?
  // No default. `@default(18)` sat here and would have credited every builder
  // inserted without a real figure with eighteen delivered projects — a
  // specific, checkable claim about a developer's track record, invented by a
  // schema line. Measured 4 Sep 2026 before removing it: all 105 builder rows
  // are NULL, so it had never fired and no data needs repair. It was a landmine
  // rather than a live fabrication, and the next bulk insert would have tripped
  // it. A missing count must read as missing — builderReputation already prints
  // a dash and says in words that a dash is a gap, not a low score.
  projects_delivered_count  Int?
  total_projects_count      Int?
  delivered_units           Int?
  delivered_projects        String[]
  ongoing_projects          String[]
  delayed_projects_count    Int?
  average_delay_months      Float?
  delivery_score            Int?

  // Quality (0-100 admin-set scores)
  construction_quality_score Int?
  after_sales_score          Int?
  buyer_satisfaction_score   Int?

  // Compliance
  rera_compliance_score      Int?
  litigation_count           Int?
  insolvency_history         Boolean   @default(false)
  legal_flag                 String?
  cin                        String?
  rera_promoter_id           String?
  financial_hygiene_score    Int?
  outstanding_dues_cr        Float?
  legal_entities             Json?     // [{name, cin, role}]
  executives                 Json?     // [{name, designation}]
  funding_banks              String[]
  audit_flags_log            String?

  // Market Position
  luxury_specialization      Boolean   @default(false)
  township_specialization    Boolean   @default(false)
  affordable_specialization  Boolean   @default(false)
  average_project_size       Int?

  // Recognition
  awards                     String[]
  awards_count               Int?
  certifications             String[]
  credai_member              Boolean   @default(false)
  iso_certified              Boolean   @default(false)

  // Confidence
  verification_level         String?
  last_verified_at           DateTime?
  data_source                String?
  intelligence_completeness  Int?

  created_at                 DateTime  @default(now())

  // Relations
  projects                   Project[]
  news                       BuilderNews[]
  account                    BuilderAccount?
  leads                      BuilderLead[]
  theme                      BuilderTheme?
  delivery_records           BuilderDeliveryRecord[]
  admin_accounts             AdminUser[]

  @@map("builders")
}

model Project {
  id                       String                 @id @default(uuid())
  slug                     String                 @unique
  name                     String
  tagline                  String?
  builder_id               String
  rera_number              String?
  rera_url                 String?
  city                     String                 @default("Noida")
  state                    String                 @default("Uttar Pradesh")
  country                  String                 @default("India")
  sector                   String
  address                  String?
  lat                      Float?
  lng                      Float?
  land_area_acres          Float?
  total_units              Int?
  total_towers             Int?
  floors                   String?
  open_space_pct           Int?
  green_rating             String?
  has_duplex               Boolean                @default(false)
  has_penthouse            Boolean                @default(false)
  project_type             String?                @default("Residential")
  schools_nearby_count     Int?
  hospitals_nearby_count   Int?
  shopping_nearby_count    Int?
  it_parks_nearby_count    Int?
  banks_nearby_count       Int?
  restaurants_nearby_count Int?
  status                   ProjectStatus
  launch_date              DateTime?
  possession_date          DateTime?
  possession_label         String?
  // very_likely | likely | at_risk | uncertain  (dictionary §2.3)
  possession_confidence      String?
  possession_confidence_note String?
  // Occupancy Certificate — drives GST rate (§5.3 stage E) and bank lending (§2.2)
  oc_obtained              Boolean?
  oc_obtained_date         DateTime?
  oc_valid_until           String?
  oc_restrictions          String?
  rera_valid_until         DateTime?
  rera_compliance_score    Int?
  // none | litigation_pending | nclt_moratorium | registry_embargo | dispute_flagged (§8.9)
  legal_flag               String?
  legal_flag_detail        String?
  litigation_count         Int?
  // Location intelligence (§6.4)
  location_advantages      Json?
  location_concerns        String[]
  location_verdict         String?
  walkability_score        Int?
  // low | medium | high  (§11.5.E)
  flood_waterlogging_risk  String?
  aqi_annual_avg           Float?
  // Commute matrix (§6.3) — [{destination, distance_km, travel_time_min, ...}]
  commute_matrix           Json?
  description              String?
  long_description         String?
  design_theme             String?
  architect                String?
  interior_designer        String?
  marketing_claims         String[]
  ai_search_keywords       String[]
  hero_image_url           String?
  price_min_cr             Float?
  price_range_label        String?
  price_includes_plc       Boolean  @default(false)
  price_includes_club      Boolean  @default(false)
  price_includes_taxes     Boolean  @default(false)
  builder_theme            Json?    // {primaryColor, secondaryColor, logoUrl, active_until}
  created_at               DateTime               @default(now())
  updated_at               DateTime               @updatedAt
  embedding                Unsupported("vector")?
  project_risk_flag        String?
  escrow_verified          Boolean?
  escrow_bank_name         String?
  registry_status          String?
  registry_embargo_reasons String[]
  nclt_moratorium_active   Boolean?

  // ──────────────────────────────────────────────────────────────
  // Phase 5: COMPREHENSIVE PROPERTY DECISION FACTORS
  // ──────────────────────────────────────────────────────────────

  // 1. Resale & Investment Terms
  resale_lock_in_months           Int?
  rental_income_allowed           Boolean?
  occupancy_restriction_months    Int?

  // 2. NRI & Eligibility
  nri_eligible                    Boolean?
  nri_approval_months             Int?
  foreign_currency_payment_allowed Boolean?

  // 3. Legal & Compliance Additions
  occupancy_certificate_status    String?
  occupancy_expected_date         DateTime?
  ongoing_litigation_count        Int?
  litigation_types                String[]
  nclt_status                     String?

  // 4. Quality & Reputation
  construction_quality_rating     Float?
  buyer_satisfaction_rating       Float?
  handover_defect_rate            Float?

  // 5. Lifestyle & Safety
  women_safety_score              Int?
  has_security_24x7               Boolean?
  has_cctv                        Boolean?
  police_station_distance_km      Float?
  street_lights                   Boolean?

  // 6. Vastu & Preferences
  vastu_compliant                 Boolean?
  north_facing_units              Boolean?
  east_facing_preferred           Boolean?

  // 7. Environmental & Area Quality
  air_quality_index_avg           Int?
  noise_level_db                  Int?
  flood_zone                      String?
  proximity_to_industrial         String?
  green_cover_percent             Int?

  // 8. Education & Connectivity
  top_school_distance_km          Float?
  college_distance_km             Float?
  hospital_distance_km            Float?
  airport_distance_km             Float?

  // 9. Market & Pricing
  market_demand_score             Int?
  appreciation_potential_5yr      Float?
  rental_yield_annual_percent     Float?
  competing_projects_nearby       Int?

  // 10. Possession & Timeline
  foundation_stone_date           DateTime?
  expected_handover_quarter       String?
  average_builder_delay_months    Int?

  // 11. Regulatory & Compliance
  gst_pass_through                Boolean?
  land_title_clear                Boolean?
  fir_against_project             Boolean?
  approvals_status                String?

  // 12. Utilities, Civic Infra & Architectural Specs (2026 Comprehensive Living Standards)
  water_source                    String?
  dg_power_rate_per_unit          Float?
  maintenance_per_sqft_monthly    Float?
  has_png_gas_pipeline            Boolean?               @default(true)
  mobile_network_rating           Int?                   // no default — see SCHEMA_DEFAULT_SENTINELS
  ceiling_height_ft               Float?                 // no default — see SCHEMA_DEFAULT_SENTINELS
  lifts_per_tower                 Int?                   // no default — see SCHEMA_DEFAULT_SENTINELS
  has_service_lift                Boolean?               @default(true)
  shared_walls_type               String?
  authority_dues_cleared          Boolean?               @default(true)
  land_tenure                     String?                @default("99-Year Authority Leasehold")
  pet_friendly                    Boolean?               @default(true)
  bachelor_tenants_allowed        Boolean?               @default(true)

  // Relations
  amenities                Amenity[]
  connectivity             Connectivity[]
  decision_profile         DecisionProfile?
  persona_profile          PersonaProfile?
  referenced_as_competitor ProjectCompetitor[]    @relation("CompetitorProject")
  competitors              ProjectCompetitor[]    @relation("SourceProject")
  dna                      ProjectDna?
  images                   ProjectImage[]
  builder                  Builder                @relation(fields: [builder_id], references: [id])
  recommendation_profile   RecommendationProfile?
  saved_by                 SavedProperty[]
  unit_types               UnitType[]
  payment_plans            PaymentPlan[]
  cost_sheet               CostSheet?
  price_history            PriceHistory[]
  construction_milestones  ConstructionMilestone[]
  construction_updates     ConstructionUpdate[]
  lifecycle_updates        ProjectLifecycleUpdate[]
  unit_inventory           UnitInventory[]
  channel_partners         ProjectChannelPartner[]
  chat_sessions            ChatSession[]          @relation("ProjectFocusedChats")
  spec_items               ProjectSpecItem[]
  property_feedback        PropertyFeedback[]     @relation("PropertyFeedback")

  @@index([city, sector])
  @@index([status])
  @@index([possession_date])
  @@index([builder_id])
  @@index([nri_eligible])
  @@index([women_safety_score])
  @@index([air_quality_index_avg])
  @@map("projects")
}

model ProjectDna {
  id                 String    @id @default(uuid())
  project_id         String    @unique

  // Overall score (0-100)
  overall_score      Int?

  // Category scores (0-100, simple manual entry)
  builder_score      Int?      // Track record + quality
  price_score        Int?      // Position relative to location/market
  location_score     Int?      // Proximity, connectivity, future growth
  legal_score        Int?      // RERA, litigation, compliance
  amenity_score      Int?      // Amenities, spacing, common areas
  possession_score   Int?      // Timeline certainty, builder track record

  // Tracking
  last_verified_at   DateTime?
  verified_by        String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  // Relation
  project            Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@map("project_dna")
}

model DecisionProfile {
  id                   String             @id @default(uuid())
  project_id           String             @unique
  status               IntelligenceStatus @default(DRAFT)

  // Decision context
  decision_thesis      String?
  why_buy              String[]           @default([])
  why_avoid            String[]           @default([])
  best_for             String?
  not_ideal_for        String?

  // Intelligence breakdown (explicit JSON fields for manual entry)
  financial_intelligence Json?            // {wealth_projection_3yr, emis_5pct, opportunity_cost, backed_by}
  market_intelligence Json?               // {supply_demand, price_appreciation, infra_catalyst, backed_by}
  builder_intelligence Json?              // {track_record, delivery_on_time_pct, satisfaction, backed_by}
  property_intelligence Json?             // {space_utilization, sun_exposure, floor_recommendation, backed_by}
  comparative_analysis Json?              // {price_vs_competitors, appreciation_potential}
  resources_documents  Json?              // {documents: [brochure, price_list, floor_plan, ...]}

  // Confidence tracking
  confidence_sources   String[]           @default([])
  recommendation_notes String?
  advisor_notes        String?

  last_verified_at     DateTime?
  verified_by          String?
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt
  project              Project            @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@map("decision_profiles")
}

model PersonaProfile {
  id                 String    @id @default(uuid())
  project_id         String    @unique
  primary_persona    String?
  secondary_personas String[]  @default([])
  persona_descriptions Json?
  income_range       String?
  family_stage       String?
  work_location      String?
  risk_appetite      String?
  timeline_horizon   String?
  motivation_note    String?
  last_verified_at   DateTime?
  verified_by        String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  project            Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@map("persona_profiles")
}

model RecommendationProfile {
  id                   String             @id @default(uuid())
  project_id           String             @unique
  project              Project            @relation(fields: [project_id], references: [id], onDelete: Cascade)

  status               IntelligenceStatus @default(DRAFT)

  // Single recommendation (replaces 6 specialized thesis fields)
  tier                 String?            // "STRONG_BUY" | "BUY" | "HOLD" | "WATCH" | "AVOID"
  primary_thesis       String?            // Main reason for this tier

  // Deal conditions
  walk_away_conditions String[]           @default([])
  timeline_advice      String?
  negotiation_leverage String[]           @default([])

  // Admin notes
  internal_confidence  String?
  admin_notes          String?

  // Tracking
  last_verified_at     DateTime?
  verified_by          String?
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt

  @@map("recommendation_profiles")
}

model ProjectCompetitor {
  id                     String    @id @default(uuid())
  project_id             String
  competitor_project_id  String?
  competitor_name        String
  competitor_slug        String?
  // Why this rival was picked — same sector, ±0.5 BHK, ±20% PSF (§10)
  reason                 String?
  competitor_price_psf         Float?
  competitor_price_min_cr      Float?
  competitor_price_max_cr      Float?
  competitor_amenity_count     Int?
  competitor_possession_status String?
  this_project_advantage String?
  competitor_advantage   String?
  verdict                String?
  price_delta_note       String?
  sort_order             Int       @default(0)
  last_verified_at       DateTime?
  verified_by            String?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt
  competitor_project     Project?  @relation("CompetitorProject", fields: [competitor_project_id], references: [id])
  project                Project   @relation("SourceProject", fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@map("project_competitors")
}

model IntelligenceAudit {
  id          String   @id @default(uuid())
  project_id  String
  section     String
  action      String
  before_data Json?
  after_data  Json?
  created_by  String?
  created_at  DateTime @default(now())

  @@index([project_id])
  @@index([project_id, section])
  @@map("intelligence_audits")
}

model UnitType {
  id                 String   @id @default(uuid())
  project_id         String
  name               String
  bhk                Int
  has_study          Boolean  @default(false)
  has_servant_room   Boolean  @default(false)
  super_area_sqft    Int?
  super_area_range_sqft String?
  carpet_area_sqft   Int?
  // carpet ÷ super × 100 (§3.1)
  carpet_to_super_ratio_pct Float?
  balconies          Int?
  balcony_area_sqft  Int?
  bathrooms          Int?
  utility_room       Boolean  @default(false)
  dress_area         Boolean  @default(false)
  towers             String[]
  // east_facing | west_facing | north_facing | south_facing
  // | garden_view | pool_view | golf_view | road_facing  (§3.1)
  unit_orientations  String[]
  orientation_price_premium_pct Float?
  price_min_cr       Float?
  price_max_cr       Float?
  price_label        String?
  // price_min ÷ SUPER area — never carpet (§Global Conventions)
  price_per_sqft     Float?
  price_is_estimated Boolean  @default(true)
  subtitle           String?
  description        String?
  category_badge     String?
  inventory_left     Int?
  inventory_as_of    DateTime?
  perfect_for        String[]
  key_highlights     Json?
  whats_included     Json?
  views              Json?
  // Layout quality (§3.4)
  layout_shape           String?
  layout_efficiency_pct  Float?
  layout_pros            String[]
  layout_cons            String[]
  layout_variant_name    String?  @default("Type A")
  tower_association      String[] @default(["Tower A"])
  built_up_area_sqft     Int?
  utility_area_sqft      Int?
  common_area_shaft_sqft Int?
  efficiency_rating      String?  @default("Excellent")
  project            Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  unit_inventory     UnitInventory[]
  spec_items         ProjectSpecItem[]

  @@index([project_id, bhk])
  @@index([project_id, price_min_cr, price_max_cr])
  @@map("unit_types")
}

model PriceHistory {
  id             String   @id @default(uuid())
  project_id     String
  recorded_at    DateTime @default(now())
  quarter_label  String?  // e.g. "Q1 2024" (§5.4)
  bhk            Int?     // config this point refers to; null = project-wide
  price_per_sqft Float?
  total_price_cr Float?
  event_note     String?  // e.g. "Metro line opened" — explains a jump
  source         String   @default("monthly_auto_snapshot") // "admin_update" | "monthly_auto_snapshot"
  project        Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id, recorded_at])
  @@map("price_history")
}

model ConstructionMilestone {
  id           String    @id @default(uuid())
  project_id   String
  // 11-stage spine (§7.A): approvals | excavation | foundation | plinth
  // | superstructure | roof_slab | masonry_plaster | finishing | amenities
  // | oc_certification | handover
  stage_code   String?
  name         String
  status       ConstructionStatus @default(upcoming)
  completion_pct Int?
  date_label   String?   // e.g. "Q1 2024"
  planned_start DateTime?
  planned_end   DateTime?
  actual_start  DateTime?
  completed_at DateTime?
  tower        String?   // null = whole project
  is_payment_trigger Boolean @default(false)
  critical_path      Boolean @default(false)
  // rera_filing | site_visit | builder_declaration | third_party_inspection
  verified_by_source String?
  photo_urls   String[]  @default([])
  sort_order   Int       @default(0)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  project      Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id, sort_order])
  @@map("construction_milestones")
}

/// Public-facing construction update feed (§7.A). One row per site update.
model ConstructionUpdate {
  id           String    @id @default(uuid())
  project_id   String
  title        String
  description  String?
  update_date  DateTime
  quarter_label String?
  completion_pct Int?
  photo_urls   String[]  @default([])
  source       String?
  verified_by  String?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  project      Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id, update_date])
  @@map("construction_updates")
}

/// Post-delivery lifecycle updates for ready/delivered projects (§7.B).
/// 10 update types: amenity_addition | maintenance_team_change | maintenance_fee_update
/// | possession_issue_resolved | regulatory_compliance | price_update
/// | possession_status_change | legal_status_change | infrastructure_nearby
/// | building_certification
model ProjectLifecycleUpdate {
  id            String    @id @default(uuid())
  project_id    String
  update_type   String
  title         String
  description   String?
  update_date   DateTime
  impact        String?
  source        String?
  verified_by   String?
  affects_pricing        Boolean @default(false)
  affects_recommendation Boolean @default(false)
  legal_flag_cleared     Boolean @default(false)
  // Populated for maintenance_fee_update rows
  maintenance_fee_monthly_psf Float?
  maintenance_fee_previous    Float?
  note          String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  project       Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id, update_date])
  @@map("project_lifecycle_updates")
}

/// Sector-level market intelligence (§6.5). Filled once per sector, reused by every
/// project in it. Not project-scoped — keyed on (city, sector).
model SectorIntelligence {
  id                    String   @id @default(uuid())
  city                  String
  sector                String
  micro_market          String?  // e.g. "Expressway Corridor", "Central Belt", "Value Hub"
  sector_overview       String?
  // emerging | developing | established | saturated
  sector_stage          String?
  dominant_segment      String?
  avg_price_per_sqft    Float?
  price_5yr_cagr_pct    Float?
  rental_yield_pct      Float?
  avg_rent_3bhk_monthly Float?
  lifestyle_tags        String[] @default([])
  sector_strengths      String[]
  sector_weaknesses     String[]
  who_should_buy        String?
  who_should_avoid      String?
  commute_anchors       Json?    // {"delhi": 35, "airport": 40, "cyber_hub": 55}
  utilities_profile     Json?    // {"water_source": "Ganga Pipeline", "tds_ppm": 250, "power_grid": "PVVNL", "dg_cost_unit": 17}
  statutory_rates       Json?    // {"circle_rate_sqm": 55000, "amenity_surcharge_pct": 3, "floor_relief_pct": 2}
  infrastructure_pipeline Json?

  // Environmental & Livability Macro Data
  aqi_annual_avg             Float?
  aqi_winter_peak            Float?
  aqi_monsoon_low            Float?
  monitoring_station_name    String?
  flood_waterlogging_risk    String?   // "LOW" | "MODERATE" | "HIGH" | "BUFFER_ZONE"
  flood_zone_description     String?
  drainage_network_quality   String?   // "EXCELLENT" | "SATISFACTORY" | "DEVELOPING"
  airport_distance_km        Float?
  nearest_metro_station      String?
  metro_distance_km          Float?
  expressway_proximity_km    Float?

  last_verified_at      DateTime?
  verified_by           String?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@unique([city, sector])
  @@index([city, micro_market])
  @@map("sector_intelligence")
}

enum ConstructionStatus {
  completed
  in_progress
  upcoming
}

model BuilderDeliveryRecord {
  id            String    @id @default(uuid())
  builder_id    String
  project_name  String
  promised_date DateTime
  actual_date   DateTime?
  created_at    DateTime  @default(now())
  builder       Builder   @relation(fields: [builder_id], references: [id], onDelete: Cascade)

  @@index([builder_id])
  @@map("builder_delivery_records")
}

model ProjectImage {
  id         String    @id @default(uuid())
  project_id String
  url        String
  type       ImageType
  source     String    @default("admin")
  caption    String?
  bhk        Int?
  size_sqft  Int?
  sort_order Int       @default(0)
  project    Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id, type])
  @@index([project_id, source])
  @@map("project_images")
}

model Amenity {
  id         String          @id @default(uuid())
  project_id String
  name       String
  category   AmenityCategory
  project    Project         @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@map("amenities")
}

model Connectivity {
  id          String           @id @default(uuid())
  project_id  String
  type        ConnectivityType
  name        String
  // ROAD distance from Google Maps — never straight line (§Global Conventions)
  distance_km Float?
  travel_time_min      Int?
  peak_travel_time_min Int?
  travel_mode          String?  // walk | drive | metro
  is_operational       Boolean  @default(true)
  category_rank        Int?     // 1 = closest/best within this type
  rating               Float?   // 0–5, from Google
  extra_detail         String?
  data_source DataSource       @default(brochure)
  notes       String?
  project     Project          @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@map("connectivity")
}

model ChatSession {
  id               String        @id @default(uuid())
  user_id          String?
  guest_token      String?
  title            String?
  message_count    Int           @default(0)
  created_at       DateTime      @default(now())
  last_active      DateTime      @default(now())
  chat_phase       String        @default("DISCOVERY")
  last_projects    Json?
  shown_chip_ids   Json?         @default("[]")
  summary          String?

  // Phase 0: Conversation Anchor — resolves pronouns in DRILLDOWN queries
  focus_project_id String?       // FK to projects.id (nullable)
  focus_project    Project?      @relation("ProjectFocusedChats", fields: [focus_project_id], references: [id], onDelete: SetNull)
  focus_set_at     DateTime?     // When focus was set (for debugging)

  // Phase 4: Topic-separated summaries (replace single 500-char summary)
  summary_location String?       // Sectors, geography, commute concerns
  summary_financial String?      // Budget, price sensitivity, investment vs. personal
  summary_timeline String?       // Possession urgency, construction tolerance, decision deadline

  // Phase 4: Property reactions tracking (enables shortlist export later)
  property_reactions Json?       @default("[]") // [{projectId, sentiment: "interested"|"concerned"|"rejected", signals: [...], timestamp}]

  messages         ChatMessage[]

  // Analytics relations
  analytics        ChatAnalytics[]
  query_metrics    QueryMetrics[]
  property_events  PropertyEvent[]

  // Phase 5: Lead enrichment — links callback requests to full chat context
  callback_requests CallbackRequest[] @relation("CallbackRequestChat")

  // Phase 5: User feedback on recommendations
  property_feedback PropertyFeedback[] @relation("PropertyFeedback")

  // Phase 0/1: Memory + Grading
  memory           SessionMemory?
  response_grades  ResponseGrade[]

  @@index([user_id])
  @@index([guest_token])
  @@map("chat_sessions")
}

