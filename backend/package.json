{
  "name": "propfyndr-backend",
  "version": "1.0.0",
  "description": "PropFyndr backend service — lead processing and notifications",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --require tsx/cjs src/test-runner.ts",
    "eval": "tsx src/lib/eval/eval-runner.ts",
    "eval:local": "tsx src/lib/eval/eval-runner.ts --endpoint=http://localhost:3002",
    "eval:staging": "tsx src/lib/eval/eval-runner.ts --endpoint=https://staging.propfyndr.com",
    "eval:prod": "tsx src/lib/eval/eval-runner.ts --endpoint=https://propfyndr.com",
    "lint": "eslint src --ext .ts --max-warnings=0",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "swagger:generate": "tsx scripts/sync-swagger.ts",
    "verify:observability": "tsx scripts/verify-observability.ts",
    "verify:chain": "tsx scripts/verify-chain.ts",
    "audit:retrieval": "tsx scripts/corpus/audit-retrieval.ts",
    "audit:prices": "tsx scripts/fix-price-labels.ts",
    "audit:data": "tsx scripts/audit-data.ts",
    "audit:routing": "tsx scripts/corpus/route-check.ts",
    "judge": "tsx scripts/corpus/judge-answers.ts",
    "corpus": "tsx scripts/corpus/run-corpus.ts",
    "check-all": "npm run lint && npm run typecheck && npm test",
    "health": "tsx scripts/health-check.ts",
    "verify:services": "tsx scripts/verify-services.ts",
    "smoke": "tsx scripts/smoke-queries.ts",
    "audit:gaps": "tsx scripts/audit-gaps-report.ts",
    "fix:builder-identity": "tsx scripts/fix-builder-identity.ts",
    "audit:duplicates": "tsx scripts/list-duplicate-builders.ts",
    "audit:queries": "tsx scripts/audit-queries.ts",
    "verify:all": "npm run verify:services && npm run verify:chain",
    "audit:master-json": "tsx scripts/audit-master-json.ts",
    "fix:track-record": "tsx scripts/fix-builder-track-record.ts",
    "audit:rera": "tsx scripts/audit-rera.ts",
    "verify:chat": "tsx scripts/verify-chat.ts",
    "audit:plans": "tsx scripts/audit-payment-plans.ts",
    "reconcile:rera": "tsx scripts/reconcile-rera.ts",
    "audit:synthetic": "tsx scripts/audit-synthetic-fields.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@prisma/client": "^5.20.0",
    "@sentry/node": "^8.0.0",
    "@supabase/supabase-js": "^2.49.8",
    "@upstash/redis": "^1.38.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.1",
    "express-async-errors": "^3.1.1",
    "file-type": "^16.5.4",
    "groq-sdk": "^0.7.0",
    "helmet": "^8.2.0",
    "js-tiktoken": "^1.0.21",
    "langfuse": "^3.38.20",
    "morgan": "^1.11.0",
    "multer": "^1.4.5-lts.2",
    "openai": "^6.42.0",
    "pino": "^9.0.0",
    "posthog-node": "^5.47.3",
    "ws": "^8.18.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.12",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.5.14",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^8.57.1",
    "glob": "^13.0.6",
    "prisma": "^5.20.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
