# RealtyPals — environment template
#
# Copy to backend/.env and frontend/.env.local, then fill in.
# Grouped by which service reads each variable; a few are needed by both.
# REQUIRED means the service will not work correctly without it.

# ─── Database (Neon Postgres; backend + frontend both run Prisma against it) ───
# REQUIRED. Pooled endpoint (host contains "-pooler") — runtime queries.
# connection_limit: Prisma defaults to CPUs x 2 + 1, which is 3 on Render's 1-CPU container;
# 25 concurrent buyers then queue for a connection and time out (load test, 6 Nov 2026).
DATABASE_URL="postgresql://USER:PASSWORD@ep-NAME-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connection_limit=15&pool_timeout=20"
# REQUIRED. Direct endpoint (same host WITHOUT "-pooler") — used by `prisma migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@ep-NAME.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ─── Buyer sign-in (Better Auth on Neon) and file storage (Neon buckets) ───
# See backend/.env.example for BETTER_AUTH_SECRET and the STORAGE_* variables.

# ─── AI providers ───
# FALLBACK_CHAIN order: Gemini > Mistral > Cerebras > Groq > OpenAI
# (backend/src/lib/config.ts). Gemini is primary. Only the OpenAI legs support tools.
GEMINI_API_KEY=""            # REQUIRED — tier 1, wired via @google/genai
GEMINI_MAIN_MODEL=""
GEMINI_LITE_MODEL=""
MISTRAL_API_KEY=""           # tier 2
CEREBRAS_API_KEY=""          # tier 3
CEREBRAS_API_KEY1=""         # optional second Cerebras key for rotation
GROQ_API_KEY=""              # tier 4
GROQ_FAST_MODEL=""
GROQ_SMART_MODEL=""
OPENAI_API_KEY=""            # tier 5 — the only tier with tools enabled
OPENAI_BASE_URL=""           # optional; OpenAI-compatible gateway
OPENAI_FALLBACK_MODEL=""
AZURE_OPENAI_API_KEY=""      # optional Azure-hosted OpenAI
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_DEPLOYMENT=""
OPENAI_AZURE_MODEL=""

# AI feature flags
ENABLE_GEMINI_FALLBACK="true"
ENABLE_GEMINI_TOOLS="false"
ENABLE_TEST_LLM="false"           # deterministic stub provider, for tests
DEBUG_FALLBACK="false"
GUARDRAILS_OBSERVE_MODE="false"   # log guardrail hits without blocking
GUARDRAILS_V2_OBSERVE_MODE="false"

# Token / cost ceilings
MAX_TOKENS_RESPONSE=""
MAX_TOKENS_ADVISORY=""
MAX_TOKENS_COMPARISON=""
SAFE_TOKEN_CEILING=""
DAILY_USER_LIMIT_USD=""
COMPRESS_ON_REQUEST=""

# ─── External data services (optional — features degrade rather than fail) ───
TAVILY_API_KEY=""                   # real-time web search
SERPER_API_KEY=""                   # web search fallback
JINA_API_KEY=""                     # embeddings / semantic search
GOOGLE_MAPS_API_KEY=""              # backend geocoding
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""  # browser Maps embed

# ─── Cache (Upstash Redis) ───
# NOTE: backend and frontend currently read DIFFERENT names for the same
# credentials. Set both pairs until they are unified.
UPSTASH_REDIS_REST_URL=""     # backend
UPSTASH_REDIS_REST_TOKEN=""   # backend
UPSTASH_REDIS_URL=""          # frontend
UPSTASH_REDIS_TOKEN=""        # frontend

# ─── Service wiring ───
PORT="3001"                                       # backend listen port (Render sets 10000)
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"              # backend CORS allow-list
BACKEND_URL="http://localhost:3001"               # frontend server-side proxy target
NEXT_PUBLIC_BACKEND_URL="http://localhost:3001"   # browser API target
NEXT_PUBLIC_SITE_URL="http://localhost:3000"      # canonical URL for metadata
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE=""                           # optional override
NEXT_PUBLIC_API_URL=""                            # optional override

# ─── Admin access ───
ADMIN_PASSWORD=""    # REQUIRED to reach /admin
ADMIN_SECRET=""      # signs the admin session cookie
ADMIN_USER_IDS=""    # comma-separated buyer account ids

# ─── Observability ───
SENTRY_DSN=""
LOG_LEVEL="info"
POSTHOG_API_KEY=""                                 # backend, server-side events
POSTHOG_HOST="https://app.posthog.com"
NEXT_PUBLIC_POSTHOG_KEY=""                         # frontend
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ─── Leads / notifications ───
NEXT_PUBLIC_WHATSAPP_NUMBER=""   # WhatsApp handoff target, digits only
WEBHOOK_URL=""
WEBHOOK_SECRET=""

# ─── Defaults ───
DEFAULT_CITY="noida"
EMI_RATE=""      # default home-loan rate for the calculator
LOAN_TENURE=""   # default tenure in years

# ─── Test-only ───
RUN_LIVE_LLM_TESTS=""   # set to 1 to run suites that hit a real LLM
