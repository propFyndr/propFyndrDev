.next-qa/
.playwright-mcp/

# Corpus run artifacts — regenerated by scripts/corpus/run-corpus.ts on every
# run, large, and they churn on every measurement. The scripts and the input
# query files are versioned; the outputs are not.
backend/scripts/corpus/results-*.json
backend/dev-server.log

# Reference prompts dropped in for study. Third-party material, not product code.
SystemPrompts/

# Generated by scripts/audit-gaps-report.ts — regenerate, do not commit.
backend/gaps-*.csv

# One-off investigation scripts and DB dumps from the ATS Pristine / master-JSON
# comparison work. Regenerable from the scripts that are versioned, and the
# db_export / with_relations dumps carry analyst-only columns (admin_notes,
# advisor_notes, internal_confidence) that projectExposure keeps off the wire —
# they should not sit in the repo either. Listed individually rather than
# ignoring backend/scripts/, which holds the corpus, audit and verify tooling.
backend/comparison_summary.txt
backend/scripts/*_pristine*.json
backend/scripts/inspect_out.json
backend/scripts/analyze-master.ts
backend/scripts/check-p1.ts
backend/scripts/check-p1-more.ts
backend/scripts/dump-comparison.ts
backend/scripts/fetch-full-relations.ts
backend/scripts/find-pristine-exact.ts
backend/scripts/generate-full-report.ts
backend/scripts/get-ats-pristine-data.ts
backend/scripts/inspect-all.ts
backend/scripts/parse-db-export.ts
backend/scripts/parse-master-json.ts
backend/scripts/print-detailed-fields.ts
backend/scripts/summarize-relations.ts

# Local DB and data-consolidation backups. 45 MB of snapshots that are useful
# on the machine that made them and noise in the history.
backend/backups/
newProj/*_backup_pre_consolidation/

# Playwright MCP scratch output (snapshots, console logs) from QA runs.
.playwright-mcp/

# One-off extraction/debug artifacts. Recoverable from git history if needed.
git_history.txt
extracted_payload.json
extracted_amenities.json

# Vitest JSON reports
**/.vitest/
